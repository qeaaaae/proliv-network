# ============================================================
# Minishop .env - положить в shop/.env (НЕ в infra/, путь фиксирован
# upstream compose: env_file = ${APP_ENV_FILE:-.env} от каталога shop/)
#
#   cp infra/minishop.env.example shop/.env
#
# Это минимальный набор для локального запуска. Полный справочник
# переменных - shop/.env.example и shop/docs/configuration/env-vars.md.
# Большинство настроек (тарифы, провайдеры, тексты) потом правятся
# в веб-админке без рестарта: Admin -> System -> Settings.
# ============================================================

# --- Режим ---
# False = браузерный режим без бота: бэкенд не ходит в Telegram API.
# Удобно для первого запуска и разработки webapp/админки локально.
# Для реального бота: True + BOT_TOKEN + туннель/домен для webhook.
TELEGRAM_ENABLED=False
BOT_TOKEN=

# Первый владелец: TG user ID и/или email - получит роль owner при первом входе.
BOOTSTRAP_OWNER_TELEGRAM_ID=
BOOTSTRAP_OWNER_EMAIL=

# --- Панель Remnawave (наша, из корневого compose) ---
# backend/worker подключены к remnawave-network через infra/minishop.compose.yml
PANEL_API_URL=http://remnawave:3000/api
# API-токен из панели: Settings -> API Tokens (нужны права на users/subscriptions/squads)
PANEL_API_KEY=
# Секрет вебхуков панели (для прода): openssl rand -hex 32
PANEL_WEBHOOK_SECRET=

# --- PostgreSQL (контейнер minishop-postgres, НЕ панельная БД) ---
POSTGRES_USER=remnawave_minishop
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=remnawave_minishop

# --- Webapp (мини-апп + админка) ---
WEBAPP_ENABLED=True
# Локальные URL; в проде - публичные HTTPS-домены
SUBSCRIPTION_MINI_APP_URL=http://127.0.0.1:8086/
PUBLIC_APP_URL=http://127.0.0.1:8086/
# Отдельный origin админ-панели Mini App (SPA + /admin/* отдаёт backend:8081).
# Нужен когда пользовательский кабинет живёт на другом домене/стеке и не знает
# про /admin/* маршруты. Бот отправляет сюда ссылки «Открыть тикет»/карточки.
# WEBAPP_ADMIN_URL=http://127.0.0.1:8085/
WEBAPP_API_BASE_URL=/api
WEBAPP_SESSION_SECRET=
EMAIL_AUTH_SECRET=
# openssl rand -base64 32 | tr '+/' '-_'
PARTNER_REQUISITES_ENCRYPTION_KEY=
PARTNER_REQUISITES_KEY_ID=v1

# --- Webhook-сервер бэкенда ---
# Без WEBHOOK_BASE_URL роуты /webhook/* провайдеров вообще не регистрируются.
# Значение должно быть ПУБЛИЧНЫМ базовым URL webhook-порта (для YooKassa
# обязательно HTTPS) - именно его + /webhook/yookassa указываешь в кабинете
# ЮKassa. Локально поднимай туннель (rathole/ngrok/cloudflared) до
# 127.0.0.1:$WEB_SERVER_PORT и ставь сюда https://<туннельный-домен>.
# Если webhook недоступен/падает - платежи всё равно завершит worker
# (сверка по API каждые ~60с), только медленнее.
WEBHOOK_BASE_URL=http://127.0.0.1:8085
WEBHOOK_SECRET_TOKEN=

# --- YooKassa (карты/СБП, RUB) ------------------------------------------
# Берутся в кабинете ЮKassa: yookassa.ru/my -> магазин -> Интеграция ->
# API-ключи. method-id для POST /api/payments: "yookassa".
# Полная инструкция e2e: infra/yookassa.md
#
# Включатель. По умолчанию True - достаточно вставить ключи.
YOOKASSA_ENABLED=True
# shopId магазина (число из кабинета).
YOOKASSA_SHOP_ID=
# Секретный ключ. Боевой: live_..., тестовый магазин: test_...
# Тестового режима-флага нет - режим определяется парой ключей.
YOOKASSA_SECRET_KEY=
# Куда возвращать плательщика после оплаты. По умолчанию - ссылка на
# TG-бота (https://t.me/<bot>); без бота подставь публичный URL мини-аппа.
YOOKASSA_RETURN_URL=
# ОБЯЗАТЕЛЬНО на практике: backend всегда шлёт блок receipt в платёж, и без
# контакта покупателя создание платежа падает (receipt_contact_missing).
# Сюда - email магазина для чеков по умолчанию.
YOOKASSA_DEFAULT_RECEIPT_EMAIL=
# Код НДС в чеке: 1=20%, 2=10%, 3=20/120, 4=10/110, 5=0%, 6=без НДС.
# Самозанятый/УСН без НДС -> 6.
YOOKASSA_VAT_CODE=6
# Автопродление по сохранённой карте (auto-renew). Опционально.
# YOOKASSA_AUTOPAYMENTS_ENABLED=False
# Показать способ оплаты только админам (ADMIN_IDS) - для тестовых оплат:
# YOOKASSA_ADMIN_ONLY_ENABLED=True
# Название кнопки в кабинете (опционально):
# PAYMENT_YOOKASSA_WEBAPP_LABEL_RU=Картой / СБП (ЮKassa)

# --- Фискализация чеков (самозанятый, 'Мой налог') ----------------------
# Отдельный канал: после успешной оплаты backend регистрирует доход в
# lknpd.nalog.ru (чек НПД). К receipt внутри ЮKassa отношения не имеет.
# Логин = ИНН самозанятого, пароль = пароль от lknpd.nalog.ru.
NALOGO_INN=
NALOGO_PASSWORD=
# NALOGO_API_URL=https://lknpd.nalog.ru/api   (дефолт, менять не надо)
# Шаблоны названия товара в чеке:
# NALOGO_RECEIPT_NAME_SUBSCRIPTION=subscription {months} months
# NALOGO_RECEIPT_NAME_TRAFFIC=traffic package {gb} GB

# --- Порты (сдвинуты с дефолтов - 8080/8082 заняты landing/cabinet) ---
WEB_SERVER_PORT=8085
WEB_SERVER_INTERNAL_PORT=8080
FRONTEND_PORT=8086

# --- Разное ---
# Анонимная телеметрия апстриму - выключаем
TELEMETRY_ENABLED=False
MAINTENANCE_MODE_ENABLED=False
# Пины образов: latest = сборка из shop/. Для готовых образов без сборки:
# IMAGE_TAG=dev / candidate-<sha> / релизный тег с Docker Hub 3252a8/*
IMAGE_TAG=latest
