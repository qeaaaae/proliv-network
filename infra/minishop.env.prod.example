# ============================================================
# PROD env для shop/.env на сервере (/opt/proliv/shop/.env)
# Создаётся командой из DEPLOY - плейсхолдеры __X__ подставляет sed.
# ============================================================

TELEGRAM_ENABLED=True
BOT_TOKEN=__BOT_TOKEN__

BOOTSTRAP_OWNER_TELEGRAM_ID=__OWNER_TG_ID__
BOOTSTRAP_OWNER_EMAIL=

# --- Панель ---
PANEL_API_URL=http://remnawave:3000/api
PANEL_API_KEY=__PANEL_API_KEY__
PANEL_WEBHOOK_SECRET=__PANEL_WEBHOOK_SECRET__

# --- PostgreSQL ---
POSTGRES_USER=remnawave_minishop
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=remnawave_minishop

# --- Webapp (наш кабинет через туннель/домен) ---
WEBAPP_ENABLED=True
SUBSCRIPTION_MINI_APP_URL=__CABINET_URL__
PUBLIC_APP_URL=__CABINET_URL__
WEBAPP_API_BASE_URL=/api
WEBAPP_SESSION_SECRET=__WEBAPP_SESSION_SECRET__
EMAIL_AUTH_SECRET=__EMAIL_AUTH_SECRET__
PARTNER_REQUISITES_ENCRYPTION_KEY=__PARTNER_KEY__
PARTNER_REQUISITES_KEY_ID=v1

# --- Webhooks ---
WEBHOOK_BASE_URL=__WEBHOOK_URL__
WEBHOOK_SECRET_TOKEN=__WEBHOOK_SECRET_TOKEN__

# --- Юзеры панели: сквады/лимиты (как базовый тариф 179 RUB) ---
USER_TRAFFIC_LIMIT_GB=1024
USER_TRAFFIC_STRATEGY=MONTH
USER_SQUAD_UUIDS=__SQUAD_UUIDS__

# --- YooKassa (выкл. до одобрения заявки; потом True + ключи) ---
YOOKASSA_ENABLED=False
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_DEFAULT_RECEIPT_EMAIL=
YOOKASSA_VAT_CODE=6

# --- Фискализация (самозанятый) ---
NALOGO_INN=
NALOGO_PASSWORD=

# --- Порты ---
WEB_SERVER_PORT=8085
WEB_SERVER_INTERNAL_PORT=8080
FRONTEND_PORT=8086

# --- Разное ---
TELEMETRY_ENABLED=False
MAINTENANCE_MODE_ENABLED=False
IMAGE_TAG=latest
