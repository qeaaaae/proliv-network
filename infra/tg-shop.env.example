# ============================================================
# Env для tg-shop бота (Jolymmiels/remnawave-telegram-shop 5.1.0)
# Скопировать: cp infra/tg-shop.env.example infra/tg-shop.env
# Файл подключается через env_file в infra/tg-shop.compose.yml
# и используется ОБОИМИ сервисами (бот + его postgres).
# Обязательные переменные помечены [ОБЯЗАТЕЛЬНО] - без них бот падает при старте.
# ============================================================

### TELEGRAM ###
# [ОБЯЗАТЕЛЬНО] Токен бота от @BotFather
TELEGRAM_TOKEN=123456:CHANGE_ME
# [ОБЯЗАТЕЛЬНО] Числовой Telegram ID админа (ОДИН id, списки не поддерживаются).
# Узнать свой id: @userinfobot
ADMIN_TELEGRAM_ID=123456789
# Язык бота по умолчанию: ru / en
DEFAULT_LANGUAGE=ru

### REMNAWAVE PANEL ###
# [ОБЯЗАТЕЛЬНО] URL API панели. БЕЗ суффикса /api - бот добавляет сам.
# Внутри remnawave-network панель доступна как http://remnawave:3000
REMNAWAVE_URL=http://remnawave:3000
# [ОБЯЗАТЕЛЬНО] API-токен панели: UI -> Settings -> API Tokens (Bearer)
REMNAWAVE_TOKEN=change_me
# remote | local. local = всегда слать X-Forwarded-For: 127.0.0.1 + X-Forwarded-Proto: https.
# При remote эти заголовки ставятся автоматически для хостов remnawave*/localhost - нам хватает remote.
REMNAWAVE_MODE=remote
# Доп. заголовки к API панели (key:value;key2:value2). Нужно, если панель за tinyauth/basic-auth:
# REMNAWAVE_HEADERS=X-Api-Key:your_key
REMNAWAVE_HEADERS=
# Тег юзеров бота в панели (маркировка платных клиентов)
REMNAWAVE_TAG=proliv_paid
# Отдельный тег для триальных юзеров (пусто = использовать REMNAWAVE_TAG)
TRIAL_REMNAWAVE_TAG=proliv_trial
# UUID internal-сквадов для юзеров, через запятую. ПУСТО = назначать все сквады панели.
SQUAD_UUIDS=
# UUID external-сквада (один), опционально
EXTERNAL_SQUAD_UUID=
# Отдельные сквады для триала (пусто = те же, что у платных)
TRIAL_INTERNAL_SQUADS=
TRIAL_EXTERNAL_SQUAD_UUID=

### БАЗА ДАННЫХ БОТА (отдельный postgres: tg-shop-db) ###
POSTGRES_USER=tgshop
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tgshop
# [ОБЯЗАТЕЛЬНО] Должен совпадать с POSTGRES_* выше; хост = имя сервиса в compose
DATABASE_URL=postgres://tgshop:CHANGE_ME@tg-shop-db:5432/tgshop?sslmode=disable

### HTTP-СЕРВЕР БОТА (healthcheck + платёжные вебхуки) ###
# Порт внутри контейнера; наружу маппится как 127.0.0.1:8090 (см. tg-shop.compose.yml)
HEALTH_CHECK_PORT=8080

### ТАРИФЫ (цены в RUB; все четыре PRICE_* обязательны) ###
# Наш тариф по SPEC: 179 руб/мес, 5 устройств (HWID-лимит задаётся в панели), 1 ТБ
PRICE_1=179
PRICE_3=479
PRICE_6=899
PRICE_12=1499
# [ОБЯЗАТЕЛЬНО] Лимит трафика платной подписки в ГБ (1 ТБ = 1024)
TRAFFIC_LIMIT=1024
# Стратегия сброса лимита: DAY | WEEK | MONTH | NO_RESET
TRAFFIC_LIMIT_RESET_STRATEGY=MONTH
# Сколько дней засчитывать за "месяц" подписки
DAYS_IN_MONTH=30
# [ОБЯЗАТЕЛЬНО] Бонусные дни рефереру за оплату друга (0 = рефералка выкл)
REFERRAL_DAYS=7
# [ОБЯЗАТЕЛЬНО] Пробный период: дни и лимит трафика в ГБ (SPEC: открытый вопрос, дефолт 3/10)
TRIAL_DAYS=3
TRIAL_TRAFFIC_LIMIT=10
TRIAL_TRAFFIC_LIMIT_RESET_STRATEGY=MONTH
# Автосписание сохранённой картой (YooKassa recurrent): true/false
ENABLE_AUTO_PAYMENT=false

### TELEGRAM STARS (оплата звёздами; публичный домен НЕ нужен) ###
TELEGRAM_STARS_ENABLED=true
# Цены в Stars на те же слоты 1/3/6/12 мес. Пусто/не задано = берутся PRICE_*
# Ориентир: 1 Star ~= 1.3 руб => 179 руб ~ 140 Stars (подобрать по факту)
STARS_PRICE_1=140
STARS_PRICE_3=370
STARS_PRICE_6=700
STARS_PRICE_12=1150
# true = Stars доступны только после первой успешной оплаты картой/криптой (анти-абьюз)
REQUIRE_PAID_PURCHASE_FOR_STARS=false

### YOOKASSA (карты; требуется публичный HTTPS-домен для вебхука) ###
YOOKASA_ENABLED=false
YOOKASA_URL=https://api.yookassa.ru/v3
YOOKASA_SHOP_ID=
YOOKASA_SECRET_KEY=
# Email покупателя для чеков
YOOKASA_EMAIL=support@proliv.net
# Путь вебхука со случайным секретом (openssl rand -hex 32). Только путь, без домена!
# В кабинете ЮKassa регистрируется ПОЛНЫЙ url: https://bot.proliv.net<этот путь>
# Пусто/не настроено = оплаты картой не подтверждаются (polling убран в 4.1.0)
YOOKASA_WEBHOOK_URL=/webhook/yookassa/CHANGE_ME_64_HEX_CHARS

### PLATEGA (СБП, карты, эквайринг, зарубежные карты, крипта) ###
PLATEGA_ENABLED=false
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Путь вебхука, регистрируется в кабинете Platega
PLATEGA_WEBHOOK_URL=/webhook/platega/CHANGE_ME_64_HEX_CHARS
# Методы (хотя бы один true, чтобы Platega появилась в меню оплаты)
PLATEGA_SBP_ENABLED=false
PLATEGA_CARDS_ENABLED=false
PLATEGA_ACQUIRING_ENABLED=false
PLATEGA_WORLDWIDE_ENABLED=false
PLATEGA_CRYPTO_ENABLED=false

### CRYPTOPAY (крипта; вебхук не нужен - бот проверяет сам) ###
CRYPTO_PAY_ENABLED=false
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_URL=https://pay.crypt.bot

### TRIBUTE (подписки Tribute; опционально, раскомментировать при использовании) ###
# TRIBUTE_WEBHOOK_URL=/webhook/tribute/CHANGE_ME_64_HEX_CHARS
# TRIBUTE_API_KEY=
# TRIBUTE_PAYMENT_URL=https://t.me/tribute/app?startapp=...

### МОЙ НАЛОГ (чеки самозанятого по платежам YooKassa; у нас самозанятость есть) ###
MOYNALOG_ENABLED=false
MOYNALOG_USERNAME=
MOYNALOG_PASSWORD=
MOYNALOG_URL=https://lknpd.nalog.ru/api/v1
# Прокси до API ФНС при необходимости (http/https/socks5)
MOYNALOG_PROXY_URL=

### MINI APP / ССЫЛКИ ИНТЕРФЕЙСА ###
# URL внешнего Mini App/ЛК: сначала можно дать sub.<domain> (штатная страница подписки),
# позже - свой webapp app.<domain> (SPEC раздел 8). Пусто = кнопки нет.
MINI_APP_URL=
# true = открывать MINI_APP_URL как WebApp-кнопкой, false = обычной ссылкой
IS_WEB_APP_LINK=false
# Кнопки-ссылки в меню бота
SERVER_STATUS_URL=
SUPPORT_URL=https://t.me/proliv_support
FEEDBACK_URL=
CHANNEL_URL=https://t.me/prolivnet
TOS_URL=
# Локальный JPEG/PNG для меню /start (с 5.1.0): положить в infra/assets/ и
# раскомментировать маунт assets в tg-shop.compose.yml. Пусто = текстовое меню.
# Путь ВНУТРИ контейнера:
MENU_PHOTO_PATH=

### МОДЕРАЦИЯ ДОСТУПА ###
# Чёрный список TG ID через запятую (полный запрет бота)
BLOCKED_TELEGRAM_IDS=
# Белый список TG ID через запятую (обход антифрод-проверок имён)
WHITELISTED_TELEGRAM_IDS=

### ПРОКСИ ДЛЯ TELEGRAM API (опционально, http/https/socks5) ###
TELEGRAM_PROXY_URL=
