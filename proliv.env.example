### APP ###
APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1

### DATABASE ###
DATABASE_URL="postgresql://postgres:CHANGE_ME@remnawave-db:5432/postgres"

### REDIS ###
REDIS_SOCKET=/var/run/valkey/valkey.sock

### Secrets (openssl rand -hex 64) ###
APP_SECRET=change_me

### PANEL DOMAIN ###
PANEL_DOMAIN=panel.example.com
FRONT_END_DOMAIN=*
SUB_PUBLIC_DOMAIN=sub.example.com

### METRICS ###
METRICS_USER=admin
METRICS_PASS=change_me

### WEBHOOKS ###
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET_HEADER=change_me_64chars_change_me_64chars_change_me_64char

### TELEGRAM NOTIFICATIONS ###
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_NOTIFY_USERS=change_me
TELEGRAM_NOTIFY_NODES=change_me
TELEGRAM_NOTIFY_CRM=change_me
TELEGRAM_NOTIFY_SERVICE=change_me
TELEGRAM_NOTIFY_TBLOCKER=change_me

### SHORT UUID ###
SHORT_UUID_METHOD=nanoid
SHORT_UUID_LENGTH=16

SERVICE_SNI_VERIFICATION=true

### Postgres container ###
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres

### Subscription page API token (panel -> Settings -> API Tokens) ###
SUBPAGE_API_TOKEN=change_me

### Landing ###
# куда ведёт кнопка "Кабинет" в шапке лендинга (локально в докере: http://localhost:8082, прод: https://app.proliv.net)
NUXT_PUBLIC_CABINET_URL=http://localhost:8082

### Cabinet (личный кабинет, app.<domain>) ###
# токен того же TG-бота - нужен для проверки подписи Telegram Login Widget
NUXT_BOT_TOKEN=change_me
# подпись сессионной куки: openssl rand -hex 32 (если пусто - берётся хэш от токена)
NUXT_SESSION_SECRET=change_me
# username бота, домен привязывается через /setdomain у BotFather (запекается в клиент при сборке образа)
NUXT_PUBLIC_BOT_USERNAME=prolivnet_bot
NUXT_PUBLIC_LANDING_URL=http://localhost:8080
# '1' включает демо-вход admin/admin - только для локальной разработки
NUXT_PUBLIC_DEV_AUTH=1
# URL WebApp API общего бэкенда (minishop). В compose: http://remnawave-minishop-backend:8081
NUXT_SHOP_API_URL=http://remnawave-minishop-backend:8081
