# --- CDN-ориджины нод - cdn-ee.proliv-network.xyz / cdn-uk.proliv-network.xyz -------------------
# Обычно живут на VPS нод, а не здесь. Если нода на этом же VPS - раскомментируй
# и поправь upstream (нода слушает host-сеть, upstream = 127.0.0.1:<port>):
#
# cdn-ee.proliv-network.xyz {
# 	encode
# 	reverse_proxy 127.0.0.1:PORT
# }
