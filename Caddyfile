# ============================================================================
# ProlivVPN - Caddyfile (ШАБЛОН)
#
# proliv-network.xyz и admin@proliv-network.xyz подставляет envsubst в infra/deploy-vps.sh.
# Отрендеренный файл лежит в /opt/proliv/Caddyfile и монтируется в контейнер
# caddy (infra/caddy.compose.yml). Не редактируй отрендеренный файл -
# правь этот шаблон и перезапускай deploy-vps.sh.
#
# Сервисные имена резолвятся через сеть remnawave-network (см. docker-compose.yml).
# ============================================================================

{
	# Email для аккаунта ACME (Let's Encrypt)
	email admin@proliv-network.xyz
}

# --- Лендинг - корневой домен ----------------------------------------------
proliv-network.xyz, www.proliv-network.xyz {
	encode
	reverse_proxy proliv-landing:80
}

# --- Личный кабинет / Mini App - app.proliv-network.xyz --------------------------------
app.proliv-network.xyz {
	encode
	# Публичные install-гайды и share-ссылки подписки (/s/<token>) отдаёт minishop
	# на :8081 - кабинет (Nuxt) этих путей не имеет. Его SPA тянет свои бандлы,
	# темы и публичный гайд-API с того же origin, поэтому whitelist повторяет
	# набор статических путей из блока admin.proliv-network.xyz. Для VPN-клиентов /s/<token>
	# отдаёт саму подписку (SUBSCRIPTION_GATEWAY) - прокси обязан быть полным.
	@minishop path /s/* /api/subscription-guides/public/* /api/bootstrap /api/i18n /subscription_webapp* /webapp-* /provider-logos/* /fonts/* /favicon.ico /apple-touch-icon* /icon-* /robots.txt
	handle @minishop {
		reverse_proxy remnawave-minishop-backend:8081 {
			header_up X-Forwarded-Proto https
		}
	}
	reverse_proxy proliv-cabinet:80
}

# --- Админка Mini App - admin.proliv-network.xyz --------------------------------------
# Веб-приложение (SPA + /api + /admin/*) отдаёт сам minishop-backend на :8081.
# Админская работа идёт внутри Telegram Mini App, поэтому из браузера открыты
# только то, что реально нужно WebView: админские страницы, API и статика.
# Всё остальное (юзерские страницы, webauth/oauth-флоу, health) - 404.
admin.proliv-network.xyz {
	encode
	@blocked not path /admin* /api/* /subscription_webapp* /webapp-* /provider-logos/* /fonts/* /favicon.ico /apple-touch-icon* /icon-* /robots.txt
	respond @blocked 404
	reverse_proxy remnawave-minishop-backend:8081 {
		header_up X-Forwarded-Proto https
	}
}

# --- Remnawave panel - panel.proliv-network.xyz --------------------------------------
panel.proliv-network.xyz {
	encode
	reverse_proxy remnawave:3000 {
		header_up X-Forwarded-Proto https
	}
}

# --- Subscription page - sub.proliv-network.xyz ---------------------------------------
sub.proliv-network.xyz {
	encode
	# Голый корень - на лендинг (subpage без uuid всё равно падает)
	@root path /
	redir @root https://proliv-network.xyz 302
	reverse_proxy remnawave-subscription-page:3010 {
		header_up X-Forwarded-Proto https
	}
}

# --- Webhooks - api.proliv-network.xyz: /tg/webhook -> bot, /webhook/* -> backend -----
api.proliv-network.xyz {
	encode
	@tg path /tg/webhook*
	handle @tg {
		reverse_proxy remnawave-minishop-bot:8080
	}
	@wh path /webhook/*
	handle @wh {
		reverse_proxy remnawave-minishop-backend:8080
	}
	handle {
		respond 404
	}
}

# --- Всё остальное на 443 - тихий 204 (как в офиц. рецепте docs.rw) -----------
:443 {
	tls internal
	respond 204
}

# ============================================================================
# БУДУЩИЕ СЕРВИСЫ - раскомментировать по мере готовности (см. SPEC.md)
# ============================================================================

